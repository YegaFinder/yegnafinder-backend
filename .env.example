# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
# Comma-separated list of allowed PWA origins
FRONTEND_ORIGIN=http://localhost:3000

# ─── Testing ─────────────────────────────────────────────────────
# Set to true to log OTPs to console instead of sending emails (for testing without domain)
TEST_MODE=false

# ─── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/yegnafinder

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ─────────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ─── Social Login ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Email Configuration (Resend) ────────────────────────────────
RESEND_API_KEY=
SMTP_FROM=onboarding@resend.dev

# ─── AWS S3 Uploads (required for avatar, logo, banner, and gallery uploads) ─
AWS_REGION=us-east-1
# Leave access keys empty when running with an IAM role or other AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional public CDN/base URL. Without it, URLs use the S3 virtual-hosted URL.
AWS_S3_CDN_URL=

# ─── Database migrations ───────────────────────────────────────
# Run the checked-in TypeORM migrations at startup in an environment where the schema is managed by migrations.
DB_MIGRATIONS_RUN=false
# Set false when using migrations as the schema source of truth.
DB_SYNCHRONIZE=true
